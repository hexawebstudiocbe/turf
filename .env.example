# Backend Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/turfbook?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Production / Test Mode Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Frontend URL
FRONTEND_URL=https://your-turf-app.vercel.app

# Frontend Client Env
VITE_API_URL=https://your-backend-api.onrender.com/api
